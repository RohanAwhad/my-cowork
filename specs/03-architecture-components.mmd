    PG -->|"routes spawn-time policy to"| RA
    CR -->|"compiles per-session mcp config for"| RA
    SM -->|"persists sessions and transcripts via"| ST
    ST -->|"SQL over WAL"| DB
    SM -->|"publishes session events on"| EB
    AW -->|"publishes artifact events on"| EB
    PG -->|"publishes permission notices on"| EB
    SE -->|"publishes scheduler ticks on"| EB
    SE -->|"fires triggers into"| SM
    SE -->|"resolves auto-approve policy with"| PG
    SE -->|"persists and reads tasks via"| ST
    PG -->|"records grants and denials via"| ST
    CR -->|"persists connector configs via"| ST

graph TD
    subgraph APP["RH Co-work App"]
        WS[WorkspaceServer]
        SM[SessionManager]
        RA[RunnerAdapter]
        PG[PermissionGate]
        EB[EventBus]
        AW[ArtifactWatcher]
        SE[SchedulerEngine]
        CR[ConnectorRegistry]
        ST[Storage]
        AU[Auth]
    end
    CLI[claude CLI subprocess]
    DB[(SQLite)]
    HFS[(Host filesystem)]

    WS -->|"session commands over HTTP and WS"| SM
    WS -->|"task commands over HTTP and WS"| SE
